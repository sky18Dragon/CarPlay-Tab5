CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK=y

CONFIG_LV_FONT_MONTSERRAT_28=y

CONFIG_LV_FONT_MONTSERRAT_40=y

CONFIG_MBEDTLS_CHACHAPOLY_C=y

CONFIG_MBEDTLS_CHACHA20_C=y

CONFIG_MBEDTLS_POLY1305_C=y

CONFIG_MBEDTLS_HKDF_C=y

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096

CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Software H.264 decoding reads PSRAM sequentially. These match M5Tab5-UserDemo and
# the ESP32-P4 settings in the esp_lvgl_adapter documentation. Measured with the
# phone stream: the line size saves 15%, 256 KB plus code in PSRAM another 11%.
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
