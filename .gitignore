# Build output and fetched dependencies
/build/
/build-*/
/managed_components/
/external/
/sdkconfig
/sdkconfig.old
/sdkconfig.*
!/sdkconfig.defaults
__pycache__/
*.dSYM/
.DS_Store

# Local-only material, except the explicitly bundled experimental identity below
/secrets/*
!/secrets/mfi/
/secrets/mfi/*
/artifacts/
/reference/
/outputs/
*.apk
*.pk8
*.p7b
*.der
*.pem
*.key

# Published experimental identity: narrow allowlist, not other credentials
!/secrets/mfi/identity.pk8
!/secrets/mfi/certificate.p7b
!/secrets/mfi/certificate.der
!/secrets/mfi/README.md
!/secrets/mfi/SHA256SUMS
